# ==============================================================================
# CARMEN - Catering Management System (Production Environment Configuration)
# Copy this file to .env on the production Windows Server:
#   copy .env.example .env
# Then generate a fresh application key:
#   php artisan key:generate
# ==============================================================================

# Application Configuration
APP_NAME="CARMEN - Catering Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://carmen.perusahaan.co.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

# PostgreSQL Database Configuration (Production Fresh Database)
# Do NOT use QA database or historical sqlite database.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=carmen_prod
DB_USERNAME=carmen_user
DB_PASSWORD=REPLACE_WITH_STRONG_PRODUCTION_PASSWORD

# Session and Security Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Logging
LOG_CHANNEL=daily
LOG_LEVEL=info
LOG_DAILY_DAYS=14

# Storage & File System
FILESYSTEM_DISK=local

# Python Executable for Official Excel Generator
# Path to python.exe with openpyxl, pandas, pillow, qrcode installed
PYTHON_PATH=C:\Python310\python.exe

# CORS & Sanctum Domains
# Comma-separated list of allowed frontend origins
CORS_ALLOWED_ORIGINS=https://carmen.perusahaan.co.id,http://127.0.0.1:3000
SANCTUM_STATEFUL_DOMAINS=carmen.perusahaan.co.id

# Queue & Cache
CACHE_STORE=database
QUEUE_CONNECTION=sync

# Mail Configuration (Optional - for notifications)
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@perusahaan.co.id"
MAIL_FROM_NAME="CARMEN System"
